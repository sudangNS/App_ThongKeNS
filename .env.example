# Sao chép thành .env.local khi chạy `vercel dev`; trên Vercel đặt trong Project → Settings → Environment Variables.

# OAuth Client ID (loại "Web application") – dùng cho nút Đăng nhập Google
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Service Account để đọc/ghi Google Sheet (chọn 1 trong 2 cách)
# Cách 1: dán nguyên file JSON key trên 1 dòng
GOOGLE_SERVICE_ACCOUNT_JSON=
# Cách 2: tách email + private key (giữ nguyên \n trong key)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Chuỗi ngẫu nhiên ≥ 32 ký tự để ký cookie phiên
SESSION_SECRET=

# Tuỳ chọn
SHEET_ID=1VVW7Zrdw-KmO2HLIh1nchKE8DRGWDtd2hCrS-e_aKUU
ALLOWED_DOMAIN=nghiason.com.vn
SESSION_HOURS=12
MAX_BACKDATE_DAYS=7
